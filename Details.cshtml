@model MaSV_LTW.Models.Customer
@using System.Collections.Generic
@{ViewBag.Title="Khách hàng";var orders=(IEnumerable<MaSV_LTW.Models.Order>)ViewBag.Orders;}<h1>@Model.CustomerName</h1><p>Điện thoại: @Model.CustomerPhone | Email: @Model.CustomerEmail</p><p>Địa chỉ: @Model.CustomerAddress</p><h2>Đơn hàng</h2><table class="table"><tr><th>Mã</th><th>Ngày</th><th>Tổng tiền</th><th></th></tr>@foreach(var o in orders){<tr><td>@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.TotalAmount.ToString("N0") đ</td><td><a href="@Url.Action("Details","Orders",new{area="Admin",id=o.OrderID})">Chi tiết</a></td></tr>}</table>@Html.ActionLink("Quay lại","Index")